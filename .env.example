# Public origin and restaurant contact
APP_URL=http://localhost:3000
PUBLIC_CONTACT_EMAIL=restaurant@example.com

# Private Google Sheet used for menu settings and orders
GOOGLE_SHEETS_ID=spreadsheet-id-between-d-and-edit
GOOGLE_SERVICE_ACCOUNT_EMAIL=heart-of-india-orders@project-id.iam.gserviceaccount.com
GOOGLE_SERVICE_ACCOUNT_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"

# Operator dashboard login. Escape literal dollar signs in local dotenv files.
# In the Vercel dashboard, paste the generated hash without the backslashes.
OPERATOR_EMAIL=restaurant-operator@example.com
OPERATOR_PASSWORD_HASH=scrypt\$generated-salt\$generated-hash
OPERATOR_SESSION_SECRET=replace-with-an-independent-random-secret-at-least-32-characters

# Protects customer order-status access. Do not reuse the session secret.
ORDER_ACCESS_SECRET=replace-with-another-independent-random-secret-at-least-32-characters

# Optional browser notifications for operator devices
VAPID_PUBLIC_KEY=generated-public-key
VAPID_PRIVATE_KEY=generated-private-key
VAPID_SUBJECT=mailto:restaurant@example.com
