# Public origin
APP_URL=http://localhost:3000

# Supabase/PostgreSQL pooled connection (server only)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/heart_of_india

# Auth.js. Generate long random values; do not reuse between environments.
AUTH_SECRET=
OPERATOR_EMAILS=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Resend verified-domain sender and restaurant recipient
RESEND_API_KEY=
RESEND_FROM_EMAIL=Heart of India Orders <orders@example.com>
ORDER_NOTIFICATION_EMAIL=
PUBLIC_CONTACT_EMAIL=

# Stripe test mode first; replace with live credentials only after launch review
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
QUOTE_SIGNING_SECRET=

# Vercel Cron and shared serverless rate limiting
CRON_SECRET=
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Enables cart/quote interaction while production checkout remains gated
PREVIEW_CART_ENABLED=true
