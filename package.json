{
  "name": "heart-of-india-ordering",
  "version": "1.0.0",
  "type": "module",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "test:db": "NODE_OPTIONS=--conditions=react-server tsx tests/integration/webhook-db.ts",
    "test:confirmation": "node scripts/confirmation-qa.mjs",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "NODE_OPTIONS=--conditions=react-server tsx scripts/migrate.ts",
    "db:seed": "NODE_OPTIONS=--conditions=react-server tsx scripts/seed.ts"
  },
  "dependencies": {
    "@auth/drizzle-adapter": "1.11.3",
    "@radix-ui/react-dialog": "1.1.23",
    "@radix-ui/react-radio-group": "1.4.7",
    "@radix-ui/react-slot": "1.3.3",
    "@react-email/render": "2.1.0",
    "@upstash/ratelimit": "2.1.0",
    "@upstash/redis": "1.38.4",
    "drizzle-orm": "0.45.2",
    "lucide-react": "1.46.0",
    "luxon": "3.7.2",
    "next": "16.3.5",
    "next-auth": "5.0.0-beta.32",
    "postgres": "3.4.9",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "resend": "6.28.0",
    "server-only": "^0.0.1",
    "stripe": "22.6.2",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "@tailwindcss/postcss": "4.3.3",
    "@testing-library/jest-dom": "6.9.1",
    "@testing-library/react": "16.3.2",
    "@types/luxon": "3.7.1",
    "@types/node": "24.10.1",
    "@types/react": "19.2.9",
    "@types/react-dom": "19.2.3",
    "drizzle-kit": "^0.31.9",
    "eslint": "9.39.2",
    "eslint-config-next": "16.3.5",
    "jsdom": "27.4.0",
    "tailwindcss": "4.3.3",
    "tsx": "4.21.0",
    "typescript": "5.9.3",
    "vitest": "5.0.1"
  },
  "overrides": {
    "esbuild": "0.28.2"
  }
}
